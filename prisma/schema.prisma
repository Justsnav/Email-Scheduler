generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model EmailJob {
  id        String    @id @default(uuid())
  recipient String
  subject   String
  body      String
  sendAt    DateTime
  status    JobStatus @default(SCHEDULED)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, sendAt])
}